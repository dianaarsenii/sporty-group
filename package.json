{
  "name": "sports-leagues",
  "version": "1.0.0",
  "private": true,
  "description": "Sports Leagues SPA - Frontend take-home assignment",
  "scripts": {
    "dev": "cross-env TS_NODE_PROJECT=tsconfig.webpack.json NODE_OPTIONS=\"--require ts-node/register\" webpack serve --mode development",
    "build": "cross-env TS_NODE_PROJECT=tsconfig.webpack.json NODE_OPTIONS=\"--require ts-node/register\" webpack --mode production",
    "start": "serve -s dist -l 3000",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.3.3",
    "serve": "^14.2.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
